APP_NAME=GestionEscolar
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Conexión principal: MySQL en Docker
DB_CONNECTION=mysql
DB_HOST=db_docker
DB_PORT=3306
DB_DATABASE=escolar_docker
DB_USERNAME=escolar_user
DB_PASSWORD=cambiar_password

# Segunda conexión: MySQL institucional (docente)
DB2_HOST=IP_DEL_DOCENTE
DB2_PORT=3306
DB2_DATABASE=nombre_bd_docente
DB2_USERNAME=usuario_docente
DB2_PASSWORD=cambiar_password

# Contraseña root del MySQL de Docker
MYSQL_ROOT_PASSWORD=cambiar_root

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync